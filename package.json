{
  "name": "colormanager",
  "displayName": "ColorManager",
  "description": "Rotates the Visual Studio Light color theme through all hues once a day.",
  "publisher": "local",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {},
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && node test/integration/run.mjs",
    "preview": "node scripts/preview.mjs",
    "extract-light-vs": "node scripts/extract-light-vs.mjs",
    "package": "npm run typecheck && npm test && npm run build && vsce package --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.140.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
